  "components": {
    "schemas": {
      "Constraints": {
        "properties": {
          "avoidStairs": {
            "type": "boolean",
            "title": "Avoidstairs",
            "default": false
          },
          "wheelchair": {
            "type": "boolean",
            "title": "Wheelchair",
            "default": false
          },
          "walkingSpeedMetersPerSecond": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.2,
            "title": "Walkingspeedmeterspersecond",
            "default": 1.0
          }
        },
        "type": "object",
        "title": "Constraints"
      },
      "EvacuationRoute": {
        "properties": {
          "routeId": {
            "type": "string",
            "title": "Routeid"
          },
          "shelterId": {
            "type": "string",
            "title": "Shelterid"
          },
          "distanceMeters": {
            "type": "number",
            "title": "Distancemeters"
          },
          "estimatedSeconds": {
            "type": "integer",
            "title": "Estimatedseconds"
          },
          "geometry": {
            "$ref": "#/components/schemas/Geometry"
          },
          "edgeIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Edgeids"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "checkedAt": {
            "type": "string",
            "title": "Checkedat"
          },
          "dataStatus": {
            "type": "string",
            "const": "simulation",
            "title": "Datastatus",
            "default": "simulation"
          }
        },
        "type": "object",
        "required": [
          "routeId",
          "shelterId",
          "distanceMeters",
          "estimatedSeconds",
          "geometry",
          "edgeIds",
          "warnings",
          "checkedAt"
        ],
        "title": "EvacuationRoute"
      },
      "Geometry": {
        "properties": {
          "type": {
            "type": "string",
            "const": "LineString",
            "title": "Type",
            "default": "LineString"
          },
          "coordinates": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Coordinates"
          }
        },
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "Geometry"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Location": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Location"
      },
      "MatchOutput": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "requesterId": {
            "type": "string",
            "title": "Requesterid"
          },
          "helperId": {
            "type": "string",
            "title": "Helperid"
          },
          "helperName": {
            "type": "string",
            "title": "Helpername"
          },
          "requesterName": {
            "type": "string",
            "title": "Requestername"
          },
          "supportType": {
            "type": "string",
            "enum": [
              "navigation",
              "translation",
              "information",
              "walking_companion"
            ],
            "title": "Supporttype"
          },
          "estimatedSeconds": {
            "type": "integer",
            "title": "Estimatedseconds"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "offered",
              "accepted",
              "meeting",
              "assisting",
              "completed",
              "rejected",
              "cancelled",
              "expired"
            ],
            "title": "Status"
          },
          "createdAt": {
            "type": "string",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "title": "Updatedat"
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiresat"
          },
          "dataStatus": {
            "type": "string",
            "const": "simulation",
            "title": "Datastatus",
            "default": "simulation"
          }
        },
        "type": "object",
        "required": [
          "id",
          "requestId",
          "requesterId",
          "helperId",
          "helperName",
          "requesterName",
          "supportType",
          "estimatedSeconds",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "title": "MatchOutput"
      },
      "Profile": {
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Displayname",
            "default": "ゲスト"
          },
          "preferredLanguage": {
            "type": "string",
            "enum": [
              "ja",
              "en"
            ],
            "title": "Preferredlanguage",
            "default": "ja"
          },
          "mobilityType": {
            "type": "string",
            "enum": [
              "normal",
              "slow_walk",
              "wheelchair",
              "assistance_required"
            ],
            "title": "Mobilitytype",
            "default": "normal"
          },
          "avoidStairs": {
            "type": "boolean",
            "title": "Avoidstairs",
            "default": false
          },
          "supportCapabilities": {
            "items": {
              "type": "string",
              "enum": [
                "navigation",
                "translation",
                "information",
                "walking_companion"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "title": "Supportcapabilities"
          },
          "isAvailableToHelp": {
            "type": "boolean",
            "title": "Isavailabletohelp",
            "default": false
          },
          "locationSharingEnabled": {
            "type": "boolean",
            "title": "Locationsharingenabled",
            "default": false
          }
        },
        "type": "object",
        "title": "Profile"
      },
      "ProfileOutput": {
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Displayname",
            "default": "ゲスト"
          },
          "preferredLanguage": {
            "type": "string",
