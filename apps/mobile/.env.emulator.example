VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tasuku.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tasuku
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_GOOGLE_MAPS_API_KEY=
