VITE_API_BASE_URL=/api/v1
# Optional: browser-restricted Google Maps JavaScript API key (not a server secret).
VITE_GOOGLE_MAPS_API_KEY=
# Set all three for Firebase anonymous sign-in. Enable Anonymous provider in Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
