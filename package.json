{
  "name": "tasuku-workspace",
  "private": true,
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/mobile",
    "build": "npm run build -w apps/mobile",
    "typecheck": "npm run typecheck -w apps/mobile",
    "api:types": "openapi-typescript docs/openapi.json -o apps/mobile/src/types/api.generated.ts && prettier --write apps/mobile/src/types/api.generated.ts",
    "format": "prettier --write \"apps/mobile/src/**/*.{ts,tsx,css}\" \"apps/mobile/*.{ts,json,html}\" \"docs/*.md\" README.md \"scripts/*.mjs\" \"tests/*.mjs\"",
    "format:check": "prettier --check \"apps/mobile/src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/*.mjs\"",
    "firebase:start": "node scripts/firebase.mjs start",
    "test:firebase": "node scripts/firebase.mjs test",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "dev:firebase": "node scripts/firebase.mjs dev"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.35.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.5.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
