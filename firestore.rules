rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Writes use the authenticated FastAPI API (Admin SDK + IAM), never direct clients.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /private_locations/{uid} {
      allow read, write: if false;
    }
    match /matches/{id} {
      allow read: if request.auth != null &&
        (resource.data.requesterId == request.auth.uid || resource.data.helperId == request.auth.uid);
      allow write: if false;
    }
    match /support_requests/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
